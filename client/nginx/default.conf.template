server {
    listen 80;
    server_name _;
    server_tokens off;

    # Look the API up through Docker's DNS on every request (cached 10 s)
    # instead of once at startup: when the api container is recreated
    # (a deploy, a restore) it gets a new IP, and nginx would keep sending
    # to the old one and return 502 until nginx itself restarted. A
    # variable in proxy_pass is what makes nginx use the resolver. With an
    # IP upstream (AWS: 127.0.0.1) nothing is looked up.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The API trusts exactly one hop (TRUST_PROXY_HOPS=1) — this one —
        # to report the real client IP for rate limiting (TASK-010).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Evidence photos (FEAT-042) are up to 5 MB; everything else keeps 1 MB.
    location /api/uploads/ {
        client_max_body_size 6m;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass $api_upstream;
    }

    # Content-hashed build output never changes under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA routing: unknown paths fall back to index.html, which must never
    # be cached or users get stuck on an old build's asset hashes.
    location / {
        add_header Cache-Control "no-cache";
        # Everything the SPA loads is same-origin and the Vite build emits
        # no inline scripts, so no 'unsafe-inline' is needed anywhere. The
        # only cross-origin traffic is error reports to Sentry's ingest
        # hosts (TASK-042), and only when the build has a DSN.
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload";
        add_header X-Content-Type-Options nosniff;
        add_header X-Frame-Options DENY;
        add_header Referrer-Policy strict-origin-when-cross-origin;
        try_files $uri /index.html;
    }
}
