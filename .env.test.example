# Copy this file to .env.test. It is loaded automatically instead of .env
# whenever NODE_ENV=test — which Jest sets by itself, so `npm test` just
# works once this file exists. Never point this at your real dev or
# production database: tests/helpers/reset.js wipes every table before
# each test.

NODE_ENV=test
PORT=4000
APP_MODE=DEMO
CLIENT_ORIGIN=http://localhost:5173

# A SEPARATE database from your everyday dev DB — see docs/TESTING.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streetboardman_test?schema=public"

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

DEFAULT_BOARDMAN_COMMISSION_RATE=0.05
DEFAULT_PLATFORM_COMMISSION_RATE=0.03
DEFAULT_RESULT_CONFIRMATION_WINDOW_HOURS=2
