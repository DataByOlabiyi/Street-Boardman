generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BETTER
  BOARDMAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BoardmanApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum WalletType {
  BETTER
  BOARDMAN
  PLATFORM
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_WIN
  COMMISSION
  REFUND
  ADJUSTMENT
}

enum CompetitionCategory {
  FOOTBALL
  SNOOKER
  FIGHT
  TABLE_GAME
  OTHER
}

enum CompetitionStatus {
  DRAFT
  BETTING_OPEN
  BETTING_CLOSED
  PENDING_CONFIRMATION
  RESULT_CONFIRMED
  DISPUTED
  PAYOUT_PROCESSING
  COMPLETED
  CANCELLED_REFUNDED
}

enum BetStatus {
  OPEN
  WON
  LOST
  REFUNDED
  VOID
}

enum ResultStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  DISPUTED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSED
  FAILED
}

enum DepositProvider {
  DEMO
  PAYSTACK
}

enum DepositStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CONFIRMED
  RESOLVED_CANCELLED
}

model User {
  id           String     @id @default(cuid())
  role         Role
  fullName     String
  phone        String     @unique
  email        String?
  passwordHash String
  pinHash      String?
  status       UserStatus @default(ACTIVE)
  isDemo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  boardmanProfile BoardmanProfile?
  wallet          Wallet?
  bets            Bet[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  disputesRaised  Dispute[]         @relation("DisputeRaisedBy")
  auditLogs       AuditLog[]
  commissionsEarned Commission[]

  @@index([role])
}

model BoardmanProfile {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id])
  businessLocation       String
  kycDocumentUrl         String?
  approvalStatus         BoardmanApprovalStatus  @default(PENDING_APPROVAL)
  commissionRateOverride Float?
  approvedByAdminId      String?
  approvedAt             DateTime?
  createdAt              DateTime                @default(now())

  competitions Competition[]

  @@index([approvalStatus])
}

model Wallet {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id])
  walletType WalletType
  balance    Decimal    @default(0) @db.Decimal(14, 2)
  currency   String     @default("NGN")
  isDemo     Boolean    @default(true)
  createdAt  DateTime   @default(now())

  transactions  WalletTransaction[]
  ledgerAccount LedgerAccount?
}

model WalletTransaction {
  id             String                @id @default(cuid())
  walletId       String
  wallet         Wallet                @relation(fields: [walletId], references: [id])
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(14, 2)
  balanceBefore  Decimal               @db.Decimal(14, 2)
  balanceAfter   Decimal               @db.Decimal(14, 2)
  referenceType  String
  referenceId    String
  note           String?
  createdAt      DateTime              @default(now())

  @@index([walletId])
  @@index([referenceType, referenceId])
}

// --- Double-entry ledger (TASK-016) ---
//
// This is the ground truth the rest of the money system is being migrated
// onto (TASK-017/018 rewrite the wallet write/read paths to use it).
// WalletTransaction above is NOT replaced yet — both exist side by side
// until that migration lands, so nothing currently reads from the ledger.
//
// Design: one row per (account, direction) rather than one row per
// debit/credit PAIR, because a single economic event often has more than
// two legs — a payout run debits one escrow account once but credits many
// winners plus the Boardman's and the platform's commission accounts.
// Everything that happened as one atomic event shares a `groupId`; the
// ledger's core invariant is that every group's DEBIT amounts sum to
// exactly its CREDIT amounts (enforced by ledgerService.postLedgerGroup,
// not by anything in this file — Postgres has no easy way to check a
// property across a dynamic set of sibling rows).
enum LedgerAccountType {
  USER_WALLET // mirrors an existing Wallet (Better or Boardman)
  PLATFORM // the platform's own revenue account
  ESCROW // one per competition, holds staked funds until payout (TASK-019)
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

model LedgerAccount {
  id            String            @id @default(cuid())
  type          LedgerAccountType
  walletId      String?           @unique
  wallet        Wallet?           @relation(fields: [walletId], references: [id])
  competitionId String?           @unique
  competition   Competition?      @relation(fields: [competitionId], references: [id])
  createdAt     DateTime          @default(now())

  entries LedgerEntry[]

  @@index([type])
}

model LedgerEntry {
  id             String               @id @default(cuid())
  groupId        String
  accountId      String
  account        LedgerAccount        @relation(fields: [accountId], references: [id])
  direction      LedgerEntryDirection
  amount         Decimal              @db.Decimal(14, 2)
  referenceType  String
  referenceId    String
  note           String?
  createdAt      DateTime             @default(now())

  @@index([accountId])
  @@index([groupId])
  @@index([referenceType, referenceId])
}

model Competition {
  id                      String              @id @default(cuid())
  boardmanProfileId       String
  boardmanProfile         BoardmanProfile     @relation(fields: [boardmanProfileId], references: [id])
  title                   String
  description             String?
  category                CompetitionCategory
  status                  CompetitionStatus   @default(DRAFT)
  bettingDeadline         DateTime
  boardmanCommissionRate  Float
  platformCommissionRate  Float
  isDemo                  Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  // Retry bookkeeping for the payout sweep (TASK-005). A competition stuck
  // in RESULT_CONFIRMED or PAYOUT_PROCESSING gets retried a bounded number
  // of times before the sweep gives up and logs loudly instead of retrying
  // forever in silence.
  payoutAttemptCount Int      @default(0)
  lastPayoutError    String?

  participants  CompetitionParticipant[]
  betOptions    BetOption[]
  bets          Bet[]
  result        Result?
  commission    Commission?
  disputes      Dispute[]
  ledgerAccount LedgerAccount?

  @@index([status])
  @@index([boardmanProfileId])
}

model CompetitionParticipant {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  name          String
  imageUrl      String?
}

model BetOption {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  label         String
  participantId String?
  totalStaked   Decimal     @default(0) @db.Decimal(14, 2)

  bets           Bet[]
  winningResults Result[]
}

model Bet {
  id               String      @id @default(cuid())
  betCode          String      @unique
  betterId         String
  better           User        @relation(fields: [betterId], references: [id])
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id])
  betOptionId      String
  betOption        BetOption   @relation(fields: [betOptionId], references: [id])
  stake            Decimal     @db.Decimal(14, 2)
  potentialPayout  Decimal     @db.Decimal(14, 2)
  status           BetStatus   @default(OPEN)
  placedAt         DateTime    @default(now())

  payout Payout?

  @@index([betterId])
  @@index([competitionId])
  @@index([status])
}

model Result {
  id                    String       @id @default(cuid())
  competitionId         String       @unique
  competition           Competition  @relation(fields: [competitionId], references: [id])
  submittedByUserId     String
  winningOptionId       String
  winningOption         BetOption    @relation(fields: [winningOptionId], references: [id])
  finalScore            String?
  evidenceUrls          String[]
  notes                 String?
  status                ResultStatus @default(PENDING_CONFIRMATION)
  confirmationDeadline  DateTime
  confirmedByAdminId    String?
  confirmedAt           DateTime?
  createdAt             DateTime     @default(now())
}

model Payout {
  id             String       @id @default(cuid())
  betId          String       @unique
  bet            Bet          @relation(fields: [betId], references: [id])
  amount         Decimal      @db.Decimal(14, 2)
  status         PayoutStatus @default(PENDING)
  idempotencyKey String       @unique
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
}

model Commission {
  id              String      @id @default(cuid())
  competitionId   String      @unique
  competition     Competition @relation(fields: [competitionId], references: [id])
  boardmanId      String
  boardman        User        @relation(fields: [boardmanId], references: [id])
  totalStakePool  Decimal     @db.Decimal(14, 2)
  boardmanAmount  Decimal     @db.Decimal(14, 2)
  platformAmount  Decimal     @db.Decimal(14, 2)
  calculatedAt    DateTime    @default(now())
}

model Deposit {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  amount             Decimal          @db.Decimal(14, 2)
  provider           DepositProvider
  providerReference  String?          @unique
  status             DepositStatus    @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime         @default(now())

  @@index([userId])
}

model Withdrawal {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  amount       Decimal          @db.Decimal(14, 2)
  destination  Json
  status       WithdrawalStatus @default(PENDING)
  requestedAt  DateTime         @default(now())
  processedAt  DateTime?

  @@index([userId])
  @@index([status])
}

model Dispute {
  id                 String        @id @default(cuid())
  competitionId      String
  competition        Competition   @relation(fields: [competitionId], references: [id])
  raisedByUserId     String
  raisedByUser       User          @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id])
  reason             String
  status             DisputeStatus @default(OPEN)
  resolvedByAdminId  String?
  resolvedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@index([competitionId])
  @@index([status])
}

model AuditLog {
  id            String    @id @default(cuid())
  actorUserId   String?
  actor         User?     @relation(fields: [actorUserId], references: [id])
  action        String
  entityType    String
  entityId      String
  beforeState   Json?
  afterState    Json?
  createdAt     DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

model SystemSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  updatedByAdminId String?
  updatedAt       DateTime @updatedAt
}
